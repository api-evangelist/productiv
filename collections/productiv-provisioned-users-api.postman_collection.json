          "name": "Productiv Publish Provisioned Users",
          "request": {
            "name": "Productiv Publish Provisioned Users",
            "description": {
              "content": "Add provisioned users for an application in Productiv. Productiv treats the set of provisioned users updated by the developer APIs as the current list of all users for the application.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "services",
                "push",
                "v1",
                "customer",
                "apps",
                ":appId",
                "users"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "appId",
                  "description": "(Required) The unique identifier of the application."
                }
              ]
