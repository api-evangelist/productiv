          "request": {
            "name": "Productiv Get Audit Events",
            "description": {
              "content": "Fetch a stream of audit events for activities performed by users on the Productiv platform. Each request returns a maximum of 500 events. If more events exist in the queried time range, the response contains a nextPageToken for pagination.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "services",
                "export",
                "v1",
                "customer",
                "audit-events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startTime",
                  "value": "<dateTime>",
                  "description": "Start time for the query range."
                },
                {
                  "disabled": false,
                  "key": "endTime",
                  "value": "<dateTime>",
                  "description": "End time for the query range."
                },
                {
                  "disabled": false,
                  "key": "nextPageToken",
                  "value": "<string>",
                  "description": "Token for fetching the next page of results, obtained from a previous response."
