          "request": {
            "name": "Productiv Get App Summaries",
            "description": {
              "content": "Query the entire list of apps that are part of your company's portfolio. Returns a small set of app attributes such as ApplicationId, AppStatus, and VendorName. For more detailed information about a particular app, use the App Details endpoint with the ApplicationId. Rate limit is 20 requests per second.",
              "type": "text/plain"
            },
