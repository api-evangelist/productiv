          "request": {
            "name": "Productiv Get Batch File Upload Urls",
            "description": {
              "content": "Get signed upload URLs for batch file uploads. Specify the filenames to upload as query parameters, and the response will return signed URLs for each file. Use the returned signed URLs to PUT each file.",
