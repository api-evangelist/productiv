                    "key": "Content-Type",
                    "value": "application/x-www-form-urlencoded"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "description": "(Required) The OAuth2 grant type.",
                      "key": "grant_type",
                      "value": "client_credentials"
                    },
                    {
                      "description": "(Required) Your application client ID.",
                      "key": "client_id",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) Your application client secret.",
                      "key": "client_secret",
                      "value": "<string>"
                    },
                    {
                      "description": "Space-separated list of scopes. Available scopes include https://api.productiv.com/connector.write and https://api.productiv.com/report.read.",
