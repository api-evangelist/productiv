                                  "name": "Productiv Publish Usage Events",
                                  "id": "900f6301-5de8-47d4-99a1-23b7100f1098",
                                  "protocolProfileBehavior": {
                                    "disableBodyPruning": true
                                  },
                                  "request": {
                                    "method": "POST",
                                    "header": [
                                      {
                                        "key": "Content-Type",
                                        "value": "application/json"
                                      }
                                    ],
                                    "body": {
                                      "mode": "raw",
                                      "raw": "{\n  \"events\": [\n    {\n      \"timestamp\": \"<long>\",\n      \"email\": \"<email>\",\n      \"eventName\": \"<string>\"\n    },\n    {\n      \"timestamp\": \"<long>\",\n      \"email\": \"<email>\",\n      \"eventName\": \"<string>\"\n    }\n  ]\n}",
                                      "options": {
                                        "raw": {
                                          "headerFamily": "json",
                                          "language": "json"
                                        }
                                      }
                                    },
                                    "url": {
                                      "raw": "{{baseUrl}}/services/push/v1/customer/apps/:appId/usage-events",
                                      "host": [
                                        "{{baseUrl}}"
                                      ],
                                      "path": [
